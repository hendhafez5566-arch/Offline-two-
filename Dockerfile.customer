FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN node scripts/prepare-customer-build.mjs
RUN npm run build
WORKDIR /app/server
RUN npm ci
RUN npm run build

FROM node:22-alpine
WORKDIR /app
COPY --from=build /app/dist ./dist
COPY --from=build /app/database ./database
COPY --from=build /app/server/package*.json ./server/
RUN cd server && npm ci --omit=dev
COPY --from=build /app/server/dist ./server/dist
COPY --from=build /app/server/license-public*.pem ./server/
WORKDIR /app/server
ENV PORT=8080
ENV VENDOR_MODE=false
EXPOSE 8080
CMD ["node","dist/server.js"]
