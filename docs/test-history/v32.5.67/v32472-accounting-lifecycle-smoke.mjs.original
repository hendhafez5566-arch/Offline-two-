import fs from 'node:fs';
import vm from 'node:vm';
import {resolve,dirname} from 'node:path';
import {fileURLToPath} from 'node:url';
const root=resolve(dirname(fileURLToPath(import.meta.url)),'..');
const makeClass=()=>({add(){},remove(){},toggle(){return false},contains(){return false}});
const makeDocument=()=>{const els=new Map();const el=id=>{if(!els.has(id))els.set(id,{id,classList:makeClass(),style:{cssText:'',setProperty(){}},dataset:{},innerHTML:'',textContent:'',value:'',checked:false,disabled:false,files:[],appendChild(){},remove(){},focus(){},closest(){return null},querySelector(){return null},querySelectorAll(){return[]},addEventListener(){},setAttribute(){},getAttribute(){return null}});return els.get(id)};return{documentElement:{classList:makeClass(),style:{setProperty(){}}},body:{classList:makeClass(),dataset:{},style:{}},activeElement:null,getElementById:el,querySelectorAll(){return[]},querySelector(){return null},addEventListener(){},createElement(){return el('created-'+Math.random())}}};
const store=new Map(),document=makeDocument();
Object.assign(globalThis,{document,window:globalThis,parent:globalThis,matchMedia:()=>({matches:false}),location:{protocol:'file:',reload(){}},innerWidth:1440,localStorage:{getItem:k=>store.get('l:'+k)??null,setItem:(k,v)=>store.set('l:'+k,String(v)),removeItem:k=>store.delete('l:'+k)},sessionStorage:{getItem:k=>store.get('s:'+k)??null,setItem:(k,v)=>store.set('s:'+k,String(v)),removeItem:k=>store.delete('s:'+k)},MutationObserver:class{observe(){} disconnect(){}},confirm:()=>true,alert:()=>{}});
Object.defineProperty(globalThis,'navigator',{value:{maxTouchPoints:0,userAgent:'ERP-v32472-Smoke',onLine:false},configurable:true});Object.defineProperty(globalThis,'screen',{value:{width:1440,height:900},configurable:true});globalThis.window.addEventListener=()=>{};globalThis.window.open=()=>null;
const appCode=fs.readFileSync(resolve(root,'dist/app.js'),'utf8')+'\n;globalThis.__host={DB,Auth,Transactions,Invoices,Accounting,CRM,Tax,DeleteCenter};globalThis.__umrah={DB:UmrahCore_DB,Ops:UmrahCore_Ops,Bridge:UmrahCore_Bridge};';
vm.runInThisContext(appCode,{filename:'app.js'});await new Promise(r=>setTimeout(r,250));
const H=globalThis.__host,U=globalThis.__umrah;H.DB.data.meta.setupComplete=true;const admin={id:'admin-lifecycle-smoke',name:'Lifecycle Admin',role:'admin',active:true,permissions:{all:true},approvalLimit:1e12};H.DB.data.users=[admin];H.Auth.user=admin;
if(!H.DB.data.treasuries.length)H.Transactions.createTreasury({name:'خزنة اختبار دورة الإلغاء',type:'cash',currency:'EGP',opening:0,silent:true});
const treasury=H.DB.data.treasuries.find(x=>x.currency==='EGP'),customer=H.Transactions.addCustomer({name:'عميل اختبار دورة البرنامج',phone:'01000000001',type:'individual'}),supplier=H.Transactions.addSupplier({name:'مورد اختبار دورة البرنامج',currency:'EGP'});U.DB.load();
const mkProgram=(name,status='planning')=>U.Ops.createProgram({programType:'umrah',name,departureDate:'2026-09-10',returnDate:'2026-09-15',capacity:10,currency:'EGP',defaultTreasuryId:treasury.id,holdHours:24,priceDouble:5000,status});
// 1) برنامج بلا أثر مالي: إلغاء ثم حذف نهائي.
const clean=mkProgram('برنامج إلغاء نظيف','planning');U.Ops.cancelProgram(clean.id,'اختبار إلغاء بلا أثر مالي');if(clean.status!=='cancelled')throw new Error('Clean program did not cancel');const cleanDelete=H.DeleteCenter.remove('umrahProgram',clean.id);if(cleanDelete?.retainedForAudit||U.DB.data.programs.some(x=>x.id===clean.id))throw new Error('Clean cancelled program was not hard-deleted');
// 2) أمر شراء: المسودة فقط تحذف، والمعتمد يلغى ولا يحذف.
const draftPO=H.CRM.addPO({supplierId:supplier.id,currency:'EGP',lines:[{description:'اختبار',qty:1,price:100,taxId:'TAX0',accountId:'5100'}]});H.CRM.removePO(draftPO.id);if(H.DB.data.purchaseOrders.some(x=>x.id===draftPO.id))throw new Error('Draft PO was not deleted');
const approvedPO=H.CRM.addPO({supplierId:supplier.id,currency:'EGP',lines:[{description:'اختبار اعتماد',qty:1,price:200,taxId:'TAX0',accountId:'5100'}]});H.CRM.approvePO(approvedPO.id);let approvedDeleteBlocked=false;try{H.CRM.removePO(approvedPO.id)}catch(e){approvedDeleteBlocked=/مسودة|الإلغاء/.test(String(e.message||e))}if(!approvedDeleteBlocked)throw new Error('Approved PO hard-delete was not blocked');H.CRM.voidPO(approvedPO.id,'اختبار دورة الإلغاء');if(approvedPO.status!=='void')throw new Error('Approved PO was not voided');
// 3) إلغاء برنامج عليه فاتورة عميل غير محصلة: يعكس الفاتورة ويحافظ على الأثر ثم المسح يكون احتفاظًا محاسبيًا.
const billed=mkProgram('برنامج بإيراد غير محصل','open');const booking=U.Ops.createBooking({programId:billed.id,customerId:customer.id,date:'2026-08-28',adults:2,childBed:0,childNoBed:0,infants:0,primaryRoomType:'double',status:'hold',discount:0});U.Ops.confirmBooking(booking.id);const inv=H.DB.data.invoices.find(x=>x.id===booking.hostInvoiceId);if(!inv||inv.status==='draft')throw new Error('Booking invoice was not posted');const journalsBeforeCancel=H.DB.data.journals.length;U.Ops.cancelProgram(billed.id,'اختبار عكس برنامج غير محصل');if(billed.status!=='cancelled'||booking.status!=='cancelled')throw new Error('Unpaid billed program did not cancel cleanly');const invAfter=H.DB.data.invoices.find(x=>x.id===booking.hostInvoiceId);if(!invAfter||!['cancelled','void'].includes(invAfter.status))throw new Error(`Cancelled booking invoice did not reverse/void: ${invAfter?.status}`);if(H.DB.data.journals.length<journalsBeforeCancel)throw new Error('Cancellation removed accounting journals');const retained=H.DeleteCenter.remove('umrahProgram',billed.id);const billedAfter=U.Ops.program(billed.id);if(!retained?.retainedForAudit||!billedAfter?.deleted||billedAfter.active!==false)throw new Error('Cancelled program with financial history was not audit-retained');
// 4) التحصيل الفعلي يمنع إلغاء البرنامج حتى التسوية.
const paid=mkProgram('برنامج عليه تحصيل فعلي','open');const paidBooking=U.Ops.createBooking({programId:paid.id,customerId:customer.id,date:'2026-08-28',adults:1,childBed:0,childNoBed:0,infants:0,primaryRoomType:'double',status:'hold',discount:0});U.Ops.confirmBooking(paidBooking.id);const deposit=U.Bridge.emit('umrah.booking.deposit.requested',{bookingId:paidBooking.id,bookingNo:paidBooking.no,amount:500,currency:'EGP',treasuryId:treasury.id,paymentMethod:'cash',date:'2026-08-28',note:'تحصيل اختبار'},`lifecycle-deposit:${paidBooking.id}`);if(!deposit?.receiptId)throw new Error('Test receipt was not created');let paidCancelBlocked=false;try{U.Ops.cancelProgram(paid.id,'اختبار منع الإلغاء مع تحصيل')}catch(e){paidCancelBlocked=/تحصيل فعلي|سندات القبض/.test(String(e.message||e))}if(!paidCancelBlocked||paid.status!=='open')throw new Error('Paid program cancellation was not correctly blocked');
// 5) الإغلاق بعد العودة يقفل التشغيل فقط ولا يحذف/يعكس قيودًا.
const returned=mkProgram('برنامج عاد وجاهز للإغلاق','returned'),journalCountBeforeClose=H.DB.data.journals.length;
U.DB.data.incidents.push({id:'INC-CLOSE-BLOCK',programId:returned.id,status:'open',title:'واقعة اختبار',active:true});
U.DB.data.operationTasks.push({id:'TASK-CLOSE-BLOCK',programId:returned.id,status:'pending',title:'مهمة حرجة',critical:true});
let operationsCloseBlocked=false;try{U.Ops.closeProgram(returned.id)}catch(e){operationsCloseBlocked=/حادث|مشكلة|مهمة تشغيل حرجة/.test(String(e.message||e))}
if(!operationsCloseBlocked||returned.status!=='returned')throw new Error('Program close did not block open incidents/critical tasks');
U.DB.data.incidents.find(x=>x.id==='INC-CLOSE-BLOCK').status='closed';for(const task of U.DB.data.operationTasks.filter(x=>x.programId===returned.id))task.status='done';
U.Ops.closeProgram(returned.id);if(returned.status!=='closed')throw new Error('Returned program did not close');if(H.DB.data.journals.length!==journalCountBeforeClose)throw new Error('Program close changed accounting journals');let closedDeleteBlocked=false;try{H.DeleteCenter.remove('umrahProgram',returned.id)}catch(e){closedDeleteBlocked=/المغلق|السجل التشغيلي/.test(String(e.message||e))}if(!closedDeleteBlocked)throw new Error('Closed program deletion was not blocked');
// 6) إلغاء فاتورة المورد يعيد أمر الشراء والالتزام للفوترة، ويصفر المتبقي والضريبة دون حذف الأثر.
const linked=mkProgram('برنامج دورة مورد مترابطة','open');
const commitmentKey='COM-LIFECYCLE-1',linkedPO=H.CRM.addPO({date:'2026-08-28',supplierId:supplier.id,programId:linked.id,costCenterId:linked.costCenterId,currency:'EGP',lines:[{description:'فندق برنامج',qty:1,price:1000,taxId:'VAT14',accountId:'5110',costCenterId:linked.costCenterId}]});
linkedPO.sourceType='umrah-procurement';linkedPO.sourceId=commitmentKey;H.CRM.approvePO(linkedPO.id);H.CRM.receivePO(linkedPO.id);
const commitment={id:'COM-ROW-1',key:commitmentKey,programId:linked.id,supplierId:supplier.id,status:'committed',hostPOId:linkedPO.id,hostPONo:linkedPO.no,hostInvoiceId:'',hostInvoiceNo:'',active:true};H.DB.data.umrahSupplierCommitments.unshift(commitment);
const linkedInvoice=H.CRM.convertPO(linkedPO.id);commitment.status='invoiced';commitment.hostInvoiceId=linkedInvoice.id;commitment.hostInvoiceNo=linkedInvoice.no;
if(linkedPO.programId!==linked.id||linkedPO.costCenterId!==linked.costCenterId||linkedInvoice.costCenterId!==linked.costCenterId)throw new Error('Program/cost-center linkage was lost during PO conversion');
if(!H.Tax.ledger().some(x=>x.sourceId===linkedInvoice.id))throw new Error('Posted supplier invoice tax was not recorded');
H.Invoices.cancel(linkedInvoice.id,'اختبار إلغاء فاتورة المورد المرتبطة');
if(linkedPO.status!=='received'||linkedPO.invoiceId||commitment.status!=='committed'||commitment.hostInvoiceId)throw new Error('Supplier invoice cancellation did not reopen the PO/Umrah commitment');
if(H.Invoices.remaining(linkedInvoice)!==0||H.Tax.ledger().some(x=>x.sourceId===linkedInvoice.id))throw new Error('Cancelled supplier invoice still affects remaining balance or tax ledger');
const replacementInvoice=H.CRM.convertPO(linkedPO.id);
if(replacementInvoice.id===linkedInvoice.id||linkedPO.invoiceId!==replacementInvoice.id||replacementInvoice.status==='void')throw new Error('Re-invoicing a reopened purchase order failed');

// 7) كل القيود غير الملغاة متوازنة.
const journals=H.DB.data.journals.filter(x=>x.status!=='void'),imbalanced=journals.filter(j=>Math.abs((j.lines||[]).reduce((z,l)=>z+(Number(l.baseDebit)||0)-(Number(l.baseCredit)||0),0))>.01);if(imbalanced.length)throw new Error(`Imbalanced journals after lifecycle operations: ${imbalanced.length}`);
console.log(JSON.stringify({ok:true,cleanDelete:'hard',approvedPO:approvedPO.status,billedProgram:billed.status,billedDelete:'audit-retained',paidCancelBlocked,operationsCloseBlocked,closedProgram:returned.status,journals:journals.length,imbalanced:imbalanced.length},null,2));
