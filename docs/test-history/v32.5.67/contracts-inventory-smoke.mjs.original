Object.assign(globalThis,{document,window:globalThis,parent:globalThis,matchMedia:()=>({matches:false}),location:{protocol:'file:',reload(){}},innerWidth:1440,localStorage:{getItem:k=>store.get('l:'+k)??null,setItem:(k,v)=>store.set('l:'+k,String(v)),removeItem:k=>store.delete('l:'+k)},sessionStorage:{getItem:k=>store.get('s:'+k)??null,setItem:(k,v)=>store.set('s:'+k,String(v)),removeItem:k=>store.delete('s:'+k)},MutationObserver:class{observe(){}disconnect(){}},confirm:()=>true,alert:()=>{}});Object.defineProperty(globalThis,'navigator',{value:{maxTouchPoints:0,userAgent:'Contracts-Smoke',onLine:false},configurable:true});Object.defineProperty(globalThis,'screen',{value:{width:1440,height:900},configurable:true});globalThis.window.addEventListener=()=>{};globalThis.window.open=()=>null;
const code=fs.readFileSync(resolve(root,'dist/app.js'),'utf8')+'\n;globalThis.__H={DB,Auth,Transactions,CRM,Invoices};globalThis.__U={DB:UmrahCore_DB,Ops:UmrahCore_Ops,CC:UmrahCore_ContractCenter,Inv:UmrahCore_Inventory,Proc:UmrahCore_Procurement,ServiceInventory:TourismServiceInventory};';vm.runInThisContext(code,{filename:'app.js'});await new Promise(r=>setTimeout(r,100));
const H=globalThis.__H,U=globalThis.__U;H.DB.data.meta.setupComplete=true;const admin={id:'contract-admin',name:'Contract Admin',role:'admin',active:true,permissions:{all:true},approvalLimit:1e12};H.DB.data.users=[admin];H.Auth.user=admin;const supplier=H.Transactions.addSupplier({name:'مورد مخزون اختبار',currency:'EGP'});U.DB.load();
const base={supplierId:supplier.id,currency:'EGP',status:'confirmed',signedDate:'2026-08-31',releaseMode:'manual',paymentSchedule:[]};
const hotel=U.Ops.addHotelContract({...base,hotelName:'فندق المخزون اليومي',city:'Makkah',from:'2026-09-10',to:'2026-09-15',singleQty:0,singleRate:0,doubleQty:10,doubleRate:100,tripleQty:0,tripleRate:0,quadQty:0,quadRate:0,quintQty:0,quintRate:0,inventoryPeriods:[{id:'IP1',from:'2026-09-12',to:'2026-09-14',roomType:'double',qty:5,rate:150}]});
const p1=U.Ops.createProgram({programType:'umrah',name:'برنامج مخزون 1',departureDate:'2026-09-10',returnDate:'2026-09-14',capacity:8,currency:'EGP',status:'planning'});const r1=U.CC.allocate('hotel',hotel.id,{programId:p1.id,autoAllocation:'no',from:'2026-09-10',to:'2026-09-15',doubleQty:4});
const live=U.CC.hotelStats(hotel.id,'double','', '2026-09-10','2026-09-15');if(live.available!==1||live.reserved!==4)throw new Error(`Date-level hotel stock wrong: ${JSON.stringify(live)}`);
const cost=U.DB.data.programCosts.find(x=>x.sourceReservationId===r1.id);if(!cost||cost.amount!==2400)throw new Error(`Seasonal hotel allocation cost wrong: ${cost?.amount}`);
const p2=U.Ops.createProgram({programType:'umrah',name:'برنامج مخزون 2',departureDate:'2026-09-10',returnDate:'2026-09-14',capacity:4,currency:'EGP',status:'planning'});let overbookBlocked=false;try{U.CC.allocate('hotel',hotel.id,{programId:p2.id,autoAllocation:'no',from:'2026-09-10',to:'2026-09-15',doubleQty:2})}catch(e){overbookBlocked=/مخزون|متاح|غير كاف/.test(String(e.message||e))}if(!overbookBlocked)throw new Error('Date-specific hotel overbooking was not blocked');
U.CC.adjustAllocation('hotel',r1.id,{doubleQty:3});if(U.CC.hotelStats(hotel.id,'double','', '2026-09-10','2026-09-15').available!==2)throw new Error('Partial hotel allocation reduction did not release stock');if(Math.round(cost.amount)!==1800)throw new Error(`Partial allocation did not update cost: ${cost.amount}`);
hotel.stopSales=[{id:'SS1',from:'2026-09-11',to:'2026-09-12',reason:'طلب المورد'}];let stopSaleBlocked=false;try{U.CC.assertHotel(hotel.id,{double:1},'2026-09-10','2026-09-13')}catch(e){stopSaleBlocked=/موقوف للبيع/.test(String(e.message||e))}if(!stopSaleBlocked)throw new Error('Stop-sale did not hard-block new allocation');hotel.stopSales=[];
const directCustomer=H.Transactions.addCustomer({name:'عميل خدمة من المخزون',phone:'01011111111',type:'individual'}),beforeDirect=U.CC.hotelStats(hotel.id,'double','', '2026-09-10','2026-09-12').available;
const directHotelService=H.Transactions.addService({date:'2026-09-01',type:'فندق',customerId:directCustomer.id,inventoryMode:'auto',hotelName:'فندق المخزون اليومي',checkIn:'2026-09-10',checkOut:'2026-09-12',roomType:'double',rooms:1,sale:1000,saleCurrency:'EGP',status:'confirmed'});
const afterDirect=U.CC.hotelStats(hotel.id,'double','', '2026-09-10','2026-09-12').available;
if(!directHotelService.inventorySource?.contractId||directHotelService.supplierInvoiceId||afterDirect!==beforeDirect-1)throw new Error(`Tourism service did not consume own hotel inventory correctly: ${JSON.stringify({beforeDirect,afterDirect,source:directHotelService.inventorySource,supplierInvoiceId:directHotelService.supplierInvoiceId})}`);
H.Transactions.cancelService(directHotelService.id,'اختبار تحرير مخزون الخدمة');const restoredDirect=U.CC.hotelStats(hotel.id,'double','', '2026-09-10','2026-09-12').available;if(restoredDirect!==beforeDirect)throw new Error(`Cancelling tourism service did not release contracted inventory: ${restoredDirect} / ${beforeDirect}`);
// Mixed fulfillment: consume all available company inventory and purchase only the uncovered remainder.
const mixedHotel=U.Ops.addHotelContract({...base,hotelName:'فندق Mixed',city:'Makkah',from:'2026-09-10',to:'2026-09-12',singleQty:0,singleRate:0,doubleQty:3,doubleRate:120,tripleQty:0,tripleRate:0,quadQty:0,quadRate:0,quintQty:0,quintRate:0});
const mixedService=H.Transactions.addService({date:'2026-09-01',type:'فندق',customerId:directCustomer.id,supplierId:supplier.id,inventoryMode:'auto',hotelName:'فندق Mixed',checkIn:'2026-09-10',checkOut:'2026-09-12',roomType:'double',rooms:5,sale:5000,saleCurrency:'EGP',cost:500,costCurrency:'EGP',status:'confirmed'});
const mixedAllocs=(H.DB.data.serviceInventoryAllocations||[]).filter(x=>x.serviceId===mixedService.id&&x.active!==false),mixedUnits=mixedAllocs.reduce((z,x)=>z+Number(x.allocation?.rooms?.double||0),0),mixedSupplierInv=H.DB.data.invoices.find(x=>x.id===mixedService.supplierInvoiceId);
if(mixedService.inventoryMode!=='mixed'||mixedUnits!==3||!mixedSupplierInv||Math.round(H.Invoices.total(mixedSupplierInv))!==500)throw new Error(`Mixed inventory fulfillment failed: ${JSON.stringify({mode:mixedService.inventoryMode,mixedUnits,supplierInvoice:mixedSupplierInv&&H.Invoices.total(mixedSupplierInv)})}`);
// Partial supplier fulfillment on purchase orders.
const partialPO=H.CRM.addPO({date:'2026-09-01',supplierId:supplier.id,currency:'EGP',lines:[{description:'غرف تنفيذ جزئي',qty:20,price:100,taxId:'TAX0'}]});H.CRM.approvePO(partialPO.id);const pl=partialPO.lines[0];H.CRM.receivePOLines(partialPO.id,{[pl.id]:15});if(partialPO.status!=='partiallyReceived'||Number(partialPO.lines[0].receivedQty)!==15)throw new Error(`Partial PO fulfillment status failed: ${JSON.stringify({status:partialPO.status,line:partialPO.lines[0]})}`);const partialInv=H.CRM.convertPO(partialPO.id);if(Math.round(H.Invoices.total(partialInv))!==1500)throw new Error(`Partial PO invoice must include received quantity only: ${H.Invoices.total(partialInv)}`);H.CRM.receivePOLines(partialPO.id,{[pl.id]:20});const partialInv2=H.CRM.convertPO(partialPO.id);if(partialInv2.id===partialInv.id||Math.round(H.Invoices.total(partialInv2))!==500||partialPO.status!=='converted'||Number(partialPO.lines[0].invoicedQty)!==20)throw new Error(`Second partial PO invoice failed: ${JSON.stringify({first:partialInv.id,second:partialInv2.id,total:H.Invoices.total(partialInv2),status:partialPO.status,line:partialPO.lines[0]})}`);

const amendment=U.CC.createAmendment('hotel',hotel.id,'زيادة سعر أيام الذروة');if(amendment.amendmentOf!==hotel.id||amendment.amendmentNo!==1||amendment.status!=='draft')throw new Error('Contract amendment lineage is invalid');
const svc=U.CC.saveService('',{...base,serviceName:'مخيم المشاعر',serviceCategory:'camp',programType:'hajj',unit:'pax',quota:50,costPerUnit:200,from:'2026-10-01',to:'2026-10-05'});const hp=U.Ops.createProgram({programType:'hajj',name:'حج خدمة تعاقدية',departureDate:'2026-10-01',returnDate:'2026-10-05',capacity:10,currency:'EGP',status:'planning'});const sr=U.CC.allocate('service',svc.id,{programId:hp.id,autoAllocation:'yes',from:'2026-10-01',to:'2026-10-05'});if(sr.allocation.units!==10||U.CC.serviceStats(svc.id).reserved!==10)throw new Error('Generic service contract allocation failed');
const released=U.CC.saveService('',{...base,serviceName:'خدمة Release',serviceCategory:'custom',programType:'umrah',unit:'pax',quota:20,costPerUnit:10,from:'2026-09-10',to:'2026-09-12',releaseMode:'rolling',releaseDays:20});let releaseBlocked=false;try{U.CC.allocate('service',released.id,{programId:p1.id,autoAllocation:'no',from:'2026-09-10',to:'2026-09-12',units:1})}catch(e){releaseBlocked=/انتهى موعد الاحتفاظ/.test(String(e.message||e))}if(!releaseBlocked)throw new Error('Rolling release did not block expired allotment');

// Multi-program flight inventory must aggregate sold seats across programs (not just take the largest program).
const flight=U.Ops.addFlightBlock({...base,name:'بلوك اختبار مجمع',supplierId:supplier.id,airline:'Test Air',outFlight:'TA100',outFrom:'CAI',outTo:'JED',outDateTime:'2026-09-10T06:00',returnFlight:'TA101',returnFrom:'MED',returnTo:'CAI',returnDateTime:'2026-09-14T20:00',seats:10,costPerSeat:300});
const fr1=U.CC.allocate('flight',flight.id,{programId:p1.id,autoAllocation:'no',seats:6}),fr2=U.CC.allocate('flight',flight.id,{programId:p2.id,autoAllocation:'no',seats:4});
U.DB.data.bookings.push({id:'INV-B1',programId:p1.id,status:'confirmed',persons:3,infants:0,active:true},{id:'INV-B2',programId:p2.id,status:'confirmed',persons:2,infants:0,active:true});
const flightLive=U.CC.flightStats(flight.id);if(flightLive.reserved!==10||flightLive.used!==5||flightLive.available!==0)throw new Error(`Cross-program flight stock wrong: ${JSON.stringify(flightLive)}`);

// Transport capacity is reusable on non-overlapping dates; used/allocated are peak concurrent values, not lifetime sums.
const transport=U.Ops.addTransportContract({...base,provider:'نقل اختبار',supplierId:supplier.id,route:'جدة — مكة',vehicleType:'bus',vehicles:2,capacityPerVehicle:10,cost:2000,from:'2026-09-01',to:'2026-09-30'});
const tr1=U.CC.allocate('transport',transport.id,{programId:p1.id,autoAllocation:'no',from:'2026-09-10',to:'2026-09-14',vehicles:1}),tr2=U.CC.allocate('transport',transport.id,{programId:p2.id,autoAllocation:'no',from:'2026-09-10',to:'2026-09-14',vehicles:1});
const p3=U.Ops.createProgram({programType:'umrah',name:'برنامج مخزون 3 غير متداخل',departureDate:'2026-09-20',returnDate:'2026-09-24',capacity:8,currency:'EGP',status:'planning'});const tr3=U.CC.allocate('transport',transport.id,{programId:p3.id,autoAllocation:'no',from:'2026-09-20',to:'2026-09-24',vehicles:1});U.DB.data.bookings.push({id:'INV-B3',programId:p3.id,status:'confirmed',persons:7,infants:0,active:true});
const transportLive=U.CC.transportStats(transport.id,'','2026-09-01','2026-10-01');if(transportLive.reservedVehicles!==2||transportLive.used!==7||transportLive.availableVehicles!==0)throw new Error(`Date-overlap transport stock wrong: ${JSON.stringify(transportLive)}`);

// Visa quota is cumulative, while Stop Sale is evaluated against the requested program dates.
const visa=U.Ops.addVisaContract({...base,serviceName:'تأشيرة اختبار',programType:'all',supplierId:supplier.id,from:'2026-09-01',to:'2026-09-30',quota:10,costPerVisa:100,processingDays:7});U.CC.allocate('visa',visa.id,{programId:p1.id,autoAllocation:'no',visas:6});U.CC.allocate('visa',visa.id,{programId:p2.id,autoAllocation:'no',visas:3});const visaLive=U.CC.visaStats(visa.id);if(visaLive.reserved!==9||visaLive.available!==1)throw new Error(`Visa quota wrong: ${JSON.stringify(visaLive)}`);visa.stopSales=[{id:'VSS',from:'2026-09-20',to:'2026-09-22',reason:'إيقاف مؤقت'}];let visaStopBlocked=false;try{U.CC.allocate('visa',visa.id,{programId:p3.id,autoAllocation:'no',visas:1})}catch(e){visaStopBlocked=/موقوف للبيع/.test(String(e.message||e))}if(!visaStopBlocked)throw new Error('Date-specific visa Stop Sale did not block the affected program');visa.stopSales=[];

// An open program may not silently reduce its critical per-pax contractual coverage below program capacity.
hp.status='open';let openCoverageBlocked=false;try{U.CC.adjustAllocation('service',sr.id,{units:9})}catch(e){openCoverageBlocked=/البرنامج مفتوح/.test(String(e.message||e))}if(!openCoverageBlocked)throw new Error('Open-program contractual coverage could be reduced below capacity');hp.status='planning';

// Fixed allocations create procurement commitments only when the program becomes commercially open; contract itself never creates AP liability.
p1.status='open';U.Proc.onProgramOpen(p1);const p1FixedCosts=U.DB.data.programCosts.filter(x=>x.programId===p1.id&&x.active!==false&&x.procurementPolicy==='fixedOnOpen'),fixedCommitments=U.DB.data.supplierCommitments.filter(x=>x.programId===p1.id&&x.status!=='cancelled'&&p1FixedCosts.some(c=>c.id===x.sourceCostId));if(fixedCommitments.length<3||fixedCommitments.some(x=>!x.hostPOId))throw new Error('Contract allocations did not flow into central purchase orders when program opened');
const journals=(H.DB.data.journals||[]).filter(x=>x.status!=='void'),imbalanced=journals.filter(j=>Math.abs((j.lines||[]).reduce((z,l)=>z+(Number(l.baseDebit)||0)-(Number(l.baseCredit)||0),0))>.01);if(imbalanced.length)throw new Error(`Imbalanced journals: ${imbalanced.length}`);
console.log(JSON.stringify({ok:true,hotelContract:hotel.contractNo,dateLevelAvailable:live.available,seasonalCost:2400,adjustedCost:cost.amount,overbookBlocked,stopSaleBlocked,amendment:amendment.contractNo,serviceContract:svc.contractNo,serviceAllocated:sr.allocation.units,releaseBlocked,flight:{reserved:flightLive.reserved,used:flightLive.used,available:flightLive.available},transport:{reservedVehicles:transportLive.reservedVehicles,usedPeak:transportLive.used,availableVehicles:transportLive.availableVehicles},visa:{reserved:visaLive.reserved,available:visaLive.available,stopSaleBlocked:visaStopBlocked},openCoverageBlocked,directServiceInventory:{service:directHotelService.no,before:beforeDirect,after:afterDirect,cost:directHotelService.cost,noDuplicateSupplierInvoice:!directHotelService.supplierInvoiceId,releasedOnCancel:restoredDirect===beforeDirect},mixedFulfillment:{mode:mixedService.inventoryMode,inventoryUnits:mixedUnits,externalInvoice:Math.round(H.Invoices.total(mixedSupplierInv))},partialPO:{status:partialPO.status,received:partialPO.lines[0].receivedQty,invoice:Math.round(H.Invoices.total(partialInv))},purchaseCommitments:fixedCommitments.length,imbalanced:imbalanced.length},null,2));
