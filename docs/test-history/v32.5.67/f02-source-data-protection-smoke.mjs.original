import assert from 'node:assert/strict';
import {readFileSync} from 'node:fs';
const read=p=>readFileSync(new URL('../'+p,import.meta.url),'utf8');
const migration=read('database/migrations/007_data_protection_dedup.sql');
const backups=read('server/src/backups.ts');
const archives=read('server/src/archives.ts');
const server=read('server/src/server.ts');
const portable=read('src/documents/attachments-backup.ts');
const pages=read('src/commercial/pages.ts');
const actions=read('src/ui/commercial-actions.ts');
const store=read('src/persistence/server-store.ts');

assert(migration.includes('erp_file_blobs'),'shared blob table missing');
assert(migration.includes('erp_backup_file_refs'),'backup attachment refs missing');
assert(backups.includes("createHash('sha256')"),'backup sha256 missing');
assert(/OFFSET\s+3/i.test(backups),'last 3 unpinned policy missing');
assert(backups.includes('pinned=false'),'unpinned retention filter missing');
assert(backups.includes('verifyBackup'),'backup verification missing');
assert(archives.includes('periodPayload'),'period-only archive payload missing');
assert(archives.includes("/^\\d{4}-12-31$/") || archives.includes("^\\d{4}-12-31$"),'annual period guard missing');
assert(pages.includes('فتح أرشيف من ملف'),'open archive file UI missing');
assert(pages.includes('الأرشيفات السنوية'),'annual archives UI missing');
assert(portable.includes('.erpbackup'),'erpbackup extension missing');
assert(portable.includes('.erparchive'),'erparchive extension missing');
assert(portable.includes('blobs'),'portable dedup blob map missing');
assert(actions.includes("typed==='RESET'") || actions.includes("'RESET'"),'typed RESET confirmation missing');
assert(store.includes("factoryReset(typed='RESET')"),'factory reset typed confirmation transport missing');
assert(!server.includes('localStorage'),'server backup must not use localStorage');
assert(!portable.includes("localStorage.setItem('snapshot"),'large snapshots must not be written to localStorage');
assert(actions.includes('ArchiveViewer'),'read-only archive viewer missing');
console.log(JSON.stringify({ok:true,dedup:true,last3:true,erpbackup:true,erparchive:true,resetProtected:true}));
