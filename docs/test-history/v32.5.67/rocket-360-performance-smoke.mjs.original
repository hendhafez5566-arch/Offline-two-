import fs from 'node:fs';
import assert from 'node:assert/strict';
import { umrahPagesText, pagesText } from './lib/split-sources.mjs';
const read=p=>fs.readFileSync(new URL('../'+p,import.meta.url),'utf8');
const party=read('src/ui/party360.ts');
const pages=pagesText();
const cleanPages=read('src/ui/clean-pages.ts');
const umrahBridge=read('src/core/umrah/data.ts');
const contracts=read('src/core/umrah/contracts.ts')+read('src/core/umrah/contracts-management.ts');
const ui=(read('src/core/umrah/ui.ts')+umrahPagesText());
const actions=read('src/core/umrah/actions-print.ts');
const db=read('src/persistence/browser-store.ts');
const umrah=read('src/core/umrah/data.ts');
const ux=read('src/ui/commercial-ux.ts');
const product=read('src/commercial/product.ts');
const accounting=read('src/accounting/engine.ts');
const styles=read('src/styles.css');
assert(party.includes("_modelCacheKey")&&party.includes('data-party360-stat="invoices"')&&party.includes("loadTab(type,id,tab='overview'"),'360 shell is not lightweight/lazy');
assert(party.includes("requestAnimationFrame")&&party.includes("slice(0,24)")&&party.includes("slice(0,22)")&&party.includes('countsAsync(type,id)')&&party.includes('await this.yieldUi()'),'More heavy sections are not deferred/chunked/capped');
const cleanPartyControl=t=>new RegExp(`(?:UI|\\(UI as any\\))\\.partyControls\\('${t}',x\\.id`).test(cleanPages);
assert(cleanPartyControl('customer')&&cleanPartyControl('supplier')&&cleanPartyControl('agent'),'ERP party Actions + More controls are not unified in the clean list module');
assert(umrahBridge.includes("partyControls(type, id)") && umrahBridge.includes(".partyControls(type, id, { compact: true })") && ((ui.match(/partyControls\('supplier'/g)||[]).length + (contracts.match(/partyControls\('supplier'/g)||[]).length >= 2), 'Umrah supplier links are not routed through the unified Actions + More bridge');
assert(!actions.includes('UmrahCore_Insights.snapshot(id)'),'Program advanced view still eagerly builds the full insight snapshot');
assert(actions.includes('segs.slice(0, 12)')&&actions.includes('c.lines.slice(0, 18)'),'Program advanced view is not capped in fast mode');
assert((ui.includes("ps.slice(0, 12)")||ui.includes("all.slice(0, 18)"))&&ui.includes('expandPrograms()')&&ui.includes('!UmrahCore_UI._programsExpanded'),'Android Umrah program list is not progressively rendered with detached-call safety');
assert(ui.includes('money-fit money-fit-cell')&&styles.includes('.money-fit-cell'),'Umrah monetary values can still overflow mobile layout');
assert(db.includes('background:!rollback')&&db.includes('background:!(waitForSave||strict)'),'Operational saves still use blocking save UX');
assert(umrah.includes('rollback = false')&&umrah.includes('rollback = strict'),'Routine Umrah saves still clone the full ERP state');
assert(ux.includes('background=options?.background===true')&&!ux.includes('},1600)'),'Background saves still show a blocking wait state');
assert(product.includes('_normalizedSignature===sig'),'Branch normalization still scans every collection on every save');
assert(accounting.includes('partyBalanceIndex()')&&accounting.includes('cachedPartyBalance'),'Party balance pages still rescan every journal line per party');
console.log(JSON.stringify({ok:true,lazyMore:true,unifiedPartyControls:true,backgroundOperationalSaves:true,umrahProgressiveRender:true,moneyFit:true,accountingIndexed:true,branchNormalizeCached:true},null,2));
