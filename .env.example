# Copy this file to .env locally and replace every placeholder. Never commit real secrets.
PORT=8080
DATABASE_URL=postgresql://tourism_erp:change-this-password@localhost:5432/tourism_erp
ERP_TENANT=company_company001
ERP_COMPANY_ID=COMPANY001
ERP_LICENSE_TOKEN=
TRIAL_DAYS=30
PG_POOL_MAX=10
SESSION_HOURS=12
MOBILE_SESSION_HOURS=720
ALLOW_TENANT_HEADER=false
ALLOW_FACTORY_RESET=false
ERP_APP_VERSION_OVERRIDE=

# Central Vendor linkage (customer build only)
VENDOR_MODE=false
VENDOR_LICENSE_URL=https://vendor.example.com
VENDOR_AGENT_KEY=
# Optional explicit central public key override. The customer build also bundles legacy + central public keys.
ERP_LICENSE_PUBLIC_KEY_B64=
LICENSE_GRACE_HOURS=72
VENDOR_LICENSE_CHECK_MINUTES=5

# Email verification and account recovery
RESEND_API_KEY=
EMAIL_FROM=ERP Support <no-reply@example.com>
EMAIL_REPLY_TO=
ERP_PUBLIC_URL=https://your-erp-domain.example
